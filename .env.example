# Copy this file to .env and fill in the secrets before running the application
# ⚠️ NEVER commit .env file to Git!

# === LLM Providers ===
# Choose one: openai, anthropic, or gemini
LLM_PROVIDER=gemini

# Get your API keys from:
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# Gemini: https://aistudio.google.com/apikey
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional model overrides (defaults: gpt-4.1, claude-opus-5-5, gemini-2.5-flash)
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# === Embedding Provider ===
# Options: openai, sentence-transformers
# sentence-transformers = local, free, no API key needed
EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-mpnet-base-v2

# === Vector Store ===
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=rag_documents
# Create the index on first use, sized for the embedding model (dims are checked on existing indices)
ELASTICSEARCH_AUTO_CREATE_INDEX=true
# For https URLs: certificates are verified unless set to false
# Retrieval: dense (kNN), sparse (BM25) or hybrid (both, fused with Reciprocal Rank Fusion)
SEARCH_MODE=hybrid
# Index refresh after ingestion: wait_for (default), true, or false for bulk backfills
INDEX_REFRESH=wait_for
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_CA_CERTS=

# === Application ===
# development/testing relax startup checks; any other value (production) refuses
# default secrets, missing API_KEYS and AUTH_ENABLED=false.
FLASK_ENV=development
# Comma-separated allowed browser origins. Empty = CORS disabled.
CORS_ORIGINS=
SECRET_KEY=change-this-to-random-secret-key
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# === Authentication & Rate Limiting ===
AUTH_ENABLED=true
API_KEYS=test-key-123,dev-key-456,prod-key-789
RATE_LIMIT_RPM=60

# === Shared state (sessions, rate limiting) ===
# Required when running several workers (the Docker image runs 4). Empty = in-memory.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# === Conversation memory ===
# Recent session messages used to rewrite follow-up questions and given to the LLM
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=4000
QUERY_CONDENSATION=true

# === URL ingestion (SSRF protection) ===
# Optional comma-separated domain allowlist (subdomains included). Empty = any public host.
INGEST_URL_ALLOWLIST=

# === Observability ===
PROMETHEUS_PORT=9000
