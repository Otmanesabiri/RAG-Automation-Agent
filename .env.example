# Copy this file to .env and fill in the secrets before running the application
# ⚠️ NEVER commit .env file to Git!

# === LLM Providers ===
# Choose one: openai, anthropic, or gemini
LLM_PROVIDER=gemini

# Get your API keys from:
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# Gemini: https://aistudio.google.com/apikey
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional model overrides (defaults: gpt-4.1, claude-opus-5-5, gemini-2.5-flash)
OPENAI_MODEL=
ANTHROPIC_MODEL=
GEMINI_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# === Embedding Provider ===
# Options: openai, sentence-transformers
# sentence-transformers = local, free, no API key needed
EMBEDDING_PROVIDER=sentence-transformers
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-mpnet-base-v2

# === Vector Store ===
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=rag_documents
# Create the index on first use, sized for the embedding model (dims are checked on existing indices)
ELASTICSEARCH_AUTO_CREATE_INDEX=true
# For https URLs: certificates are verified unless set to false
# Retrieval: dense (kNN), sparse (BM25) or hybrid (both, fused with Reciprocal Rank Fusion)
SEARCH_MODE=hybrid
# Query expansion: none, multi_query (LLM reformulations) or hyde (hypothetical answer passage).
# Each adds one LLM call and extra searches per query.
QUERY_EXPANSION=none
MULTI_QUERY_COUNT=3
# Index refresh after ingestion: wait_for (default), true, or false for bulk backfills
INDEX_REFRESH=wait_for
ELASTICSEARCH_VERIFY_CERTS=true
ELASTICSEARCH_CA_CERTS=

# === Application ===
# development/testing relax startup checks; any other value (production) refuses
# default secrets, missing API_KEYS and AUTH_ENABLED=false.
FLASK_ENV=development
# Comma-separated allowed browser origins. Empty = CORS disabled.
CORS_ORIGINS=
SECRET_KEY=change-this-to-random-secret-key
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# === Authentication & Rate Limiting ===
AUTH_ENABLED=true
API_KEYS=test-key-123,dev-key-456,prod-key-789
RATE_LIMIT_RPM=60

# === Identity & multi-tenancy ===
# JWT (OIDC) authentication, in addition to API keys. Use JWT_JWKS_URL for an identity provider,
# or JWT_SECRET (HS256) for development.
JWT_JWKS_URL=
JWT_SECRET=
JWT_AUDIENCE=
JWT_ISSUER=
# Claims (dotted paths allowed, e.g. realm_access.roles)
JWT_TENANT_CLAIM=tenant
JWT_ROLES_CLAIM=roles
JWT_ACCESS_CLAIM=access_levels
# true = every document belongs to the caller's tenant and searches never cross tenants
MULTI_TENANT=false
# Optional per-API-key restrictions, keyed by the key's SHA-256 hex digest:
# API_KEY_SCOPES={"<sha256>": {"tenant": "acme", "roles": ["reader"], "access_levels": ["public"]}}
API_KEY_SCOPES=
# JSON-lines audit trail (ingest, query, agent, delete, sync)
AUDIT_LOG_FILE=logs/audit.log

# === Shared state (sessions, rate limiting) ===
# Required when running several workers (the Docker image runs 4). Empty = in-memory.
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# === Connectors & background jobs ===
# JSON file declaring the sources to sync (see configs/connectors.example.json)
CONNECTORS_CONFIG=
# Threads running background jobs (connector syncs, ?async=true ingestion) per API process
JOB_WORKERS=2
# Confluence API token, referenced by token_env in the connectors file
CONFLUENCE_API_TOKEN=

# === Automations (digests, watches, webhooks) ===
# Notification channels: JSON webhook (Slack/Teams/generic) and/or SMTP e-mail
NOTIFY_WEBHOOK_URL=
NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=rag-agent@example.com
SMTP_STARTTLS=true
# Shared secret for POST /webhooks/ingest (X-Signature: sha256=<HMAC of the body>). Empty = disabled.
WEBHOOK_SECRET=

# === Agent (/agent) ===
# Maximum LLM turns per agent run (each turn may call several tools)
AGENT_MAX_ITERATIONS=6

# === Citation check ===
# off, lexical (fuzzy text matching) or llm (LLM judge: one extra call per answer)
CITATION_CHECK=off

# === Conversation memory ===
# Recent session messages used to rewrite follow-up questions and given to the LLM
HISTORY_MAX_MESSAGES=6
HISTORY_MAX_CHARS=4000
QUERY_CONDENSATION=true

# === OCR (optional extras) ===
# Tesseract languages for scanned PDF pages
OCR_LANGUAGES=eng+fra

# === URL ingestion (SSRF protection) ===
# Optional comma-separated domain allowlist (subdomains included). Empty = any public host.
INGEST_URL_ALLOWLIST=

# === Observability ===
PROMETHEUS_PORT=9000
# Extra/overriding LLM prices in USD per million tokens, for rag_agent_llm_cost_usd_total
# LLM_PRICES={"my-model": [1.0, 4.0]}
# OpenTelemetry tracing (needs requirements-extras.txt): OTLP/HTTP endpoint, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rag-agent
